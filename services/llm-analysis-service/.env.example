# LLM Analysis Service Environment Configuration
# Copy this to .env and configure your credentials

# Elasticsearch Configuration
ES_CLOUD_ID=your-deployment-name:dXMtZWFzdC0xLmF3cy5mb3VuZC5pbyRjZWY4...
ES_API_KEY=your-base64-encoded-api-key

# LLM Provider (openai, anthropic, azure, custom)
LLM_PROVIDER=openai

# OpenAI Configuration
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4-turbo-preview

# Anthropic Configuration (alternative)
# ANTHROPIC_API_KEY=sk-ant-...
# ANTHROPIC_MODEL=claude-3-opus-20240229

# Azure OpenAI Configuration (alternative)
# AZURE_OPENAI_ENDPOINT=https://your-resource.openai.azure.com/
# AZURE_OPENAI_KEY=...
# AZURE_OPENAI_DEPLOYMENT=gpt-4

# Custom LLM Endpoint (alternative)
# CUSTOM_LLM_ENDPOINT=http://localhost:11434/api/generate
# CUSTOM_LLM_API_KEY=optional

# Service Configuration
PORT=5000
DEBUG=False
