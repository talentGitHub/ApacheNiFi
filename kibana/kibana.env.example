# Example Configuration for Kibana Dashboard Import
#
# Copy this file and customize it for your environment
# Then source it before running the import script:
#   source kibana.env
#   ./kibana/import-dashboard.sh
#

# Kibana URL (required)
# This should be your Elasticsearch Cloud Kibana URL
# Example for Elasticsearch Cloud: https://your-deployment-name.kb.region.cloud.es.io
export KIBANA_URL="https://your-kibana-instance.kb.cloud"

# Kibana Credentials (required for API import)
# Username with kibana_admin or saved object management permissions
export KIBANA_USER="your-username"
# Note: For security, consider using a .env file that's in .gitignore
# or enter the password interactively when prompted
export KIBANA_PASSWORD="your-password"

# Index Pattern ID (optional - only needed if customizing)
# The dashboard expects this index pattern ID
# Default: 0d3c68e1-a71e-493f-8503-c8700108ed4d
# export INDEX_PATTERN_ID="0d3c68e1-a71e-493f-8503-c8700108ed4d"

# Index Pattern Name (for reference)
# The dashboard is configured to use this pattern
export INDEX_PATTERN_NAME="nifi-diag*"

# Time Field (for reference)
# The dashboard uses this field for time-based filtering
export TIME_FIELD="@timestamp"
